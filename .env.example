# Microsoft Graph (corporate M365 app registration — client-credentials flow)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
MAIL_FROM=sender@yourcompany.com

# Subscriber storage (private Gist with a single file: subscribers.json)
GIST_TOKEN=ghp_your_gist_classic_pat
GIST_ID=your_gist_id_hash

# ── Phase 2a backend (Supabase) ──────────────────────────────────────────────
# Supabase → Project Settings → API. These power the serverless cache function
# (api/market.mjs) and the one-time seed (scripts/seed-spacex.mjs).
#
# SERVER-SIDE ONLY. The service-role key is write-capable and bypasses RLS — it
# must live only in the Vercel function's env (and your local .env for the seed/
# verify scripts). NEVER expose it to the browser; NEVER prefix it NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Live-verification runner only (scripts/verify-phase2a.mjs) — your Vercel URL.
BASE_URL=https://your-deployment.vercel.app

# ── Operator mint scripts (create-invite-code / create-org-code) ─────────────
# Link base for the printed /signup?code=… URL when minting against DEV
# (defaults to http://localhost:3000 when unset).
PUBLIC_APP_URL=http://localhost:3000
# To mint against PROD, pass --prod: the scripts then read a separate .env.prod
# file (GITIGNORED — never commit it; create it yourself in the repo root):
#   PROD_SUPABASE_URL=https://<prod-ref>.supabase.co
#   PROD_SUPABASE_SERVICE_ROLE_KEY=<prod service-role key>
#   PROD_PUBLIC_APP_URL=https://<your deployed app domain>
# The scripts print which project they target and REFUSE a prod mint with a
# localhost link (and vice versa) — see scripts/operator-env.mjs.

# ── Phase 2c frontend (Next.js client) ───────────────────────────────────────
# CLIENT-EXPOSED on purpose: NEXT_PUBLIC_* is inlined into the browser bundle.
# ONLY the URL + the ANON key may be public (the anon key is safe; RLS gates it).
# NEVER add NEXT_PUBLIC_ to the service-role key — that is the boundary that keeps
# the write-capable credential out of the client bundle (the PAT lesson).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
